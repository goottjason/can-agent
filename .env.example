# ===========================================
# CAN Agent 환경 변수 설정
# ===========================================
# 이 파일을 .env로 복사하여 사용하세요.
# .env 파일은 Git에서 제외됩니다.

# ===========================================
# DART API (재무제표 조회)
# ===========================================
# 발급: https://opendart.fss.or.kr/
DART_API_KEY=

# ===========================================
# KRX API (주가 정보 조회)
# ===========================================
# 발급: https://www.data.go.kr/
KRX_API_KEY=

# ===========================================
# 한국투자증권 API (실제 매매 연동)
# ===========================================
# 발급: https://apiportal.koreainvestment.com/
# 실전계좌와 모의계좌를 모두 사용할 수 있습니다.

# 앱 키 (실전계좌용)
KOREA_INVESTMENT_APP_KEY=

# 앱 시크릿 (실전계좌용)
KOREA_INVESTMENT_APP_SECRET=

# 계좌번호 (실전계좌: 12345678-01, 모의계좌: 12345678-02)
KOREA_INVESTMENT_ACCOUNT_NUMBER=

# 실전투자 여부 (true: 실전투자, false: 모의투자)
KOREA_INVESTMENT_IS_REAL=false

# ===========================================
# 모의투자용 별도 설정 (선택)
# ===========================================
# 모의투자는 별도의 앱 키/시크릿이 필요할 수 있습니다.
# # KOREA_INVESTMENT_MOCK_APP_KEY=
# # KOREA_INVESTMENT_MOCK_APP_SECRET=
# # KOREA_INVESTMENT_MOCK_ACCOUNT_NUMBER=

# ===========================================
# 알림 설정 (선택)
# ===========================================

# 텔레그램 알림
# 봇 생성: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 카카오 웹훅 알림
# 카카오 워크 채널에서 웹훅 URL 생성
KAKAO_WEBHOOK_URL=
