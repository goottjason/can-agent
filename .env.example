# ===========================================
# CAN Agent 환경 변수 설정
# ===========================================
# 이 파일을 .env로 복사하여 사용하세요.
# .env 파일은 Git에서 제외됩니다.

# ===========================================
# DART API (재무제표 조회)
# ===========================================
# 발급: https://opendart.fss.or.kr/
DART_API_KEY=

# ===========================================
# KRX API (주가 정보 조회)
# ===========================================
# 발급: https://www.data.go.kr/
KRX_API_KEY=

# ===========================================
# 한국투자증권 API (실제 매매 연동)
# ===========================================
# 발급: https://apiportal.koreainvestment.com/
# 실전계좌와 모의계좌를 모두 사용할 수 있습니다.

# 앱 키 (실전계좌용)
KOREA_INVESTMENT_APP_KEY=

# 앱 시크릿 (실전계좌용)
KOREA_INVESTMENT_APP_SECRET=

# 계좌번호 (실전계좌: 12345678-01, 모의계좌: 12345678-02)
KOREA_INVESTMENT_ACCOUNT_NUMBER=

# 실전투자 여부 (true: 실전투자, false: 모의투자)
KOREA_INVESTMENT_IS_REAL=false

# ===========================================
# 모의투자용 별도 설정 (선택)
# ===========================================
# 모의투자는 별도의 앱 키/시크릿이 필요할 수 있습니다.
# # KOREA_INVESTMENT_MOCK_APP_KEY=
# # KOREA_INVESTMENT_MOCK_APP_SECRET=
# # KOREA_INVESTMENT_MOCK_ACCOUNT_NUMBER=

# ===========================================
# 알림 설정 (선택)
# ===========================================

# 텔레그램 알림
# 봇 생성: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 카카오 웹훅 알림
# 카카오 워크 채널에서 웹훅 URL 생성
KAKAO_WEBHOOK_URL=

# ===========================================
# 주식 실매매 스위치 (prod)
# ===========================================
# true: 실제 주문 실행 / false: 시뮬레이션(관측모드). prod 기본값은 true이므로
# 관측모드 유지를 위해 서버 docker-compose에 REAL_TRADING=false를 명시해 둔 상태.
# 실매매 시작 시 이 값을 true로 바꾸고 재배포.
REAL_TRADING=false

# ===========================================
# 복권 자동구매 (사이드카)
# ===========================================
# 기능 게이트/드라이런(안전 기본 off). 실구매 시 ENABLED=true, DRY_RUN=false.
LOTTERY_ENABLED=false
LOTTERY_DRY_RUN=true
# 컨테이너 내 venv 파이썬 + 사이드카 경로(콤마구분).
LOTTERY_SIDECAR_CMD=/app/sidecar/lottery/.venv/bin/python,/app/sidecar/lottery/buy.py
# 자동구매 대상. 연금(WIN720) Playwright 미구현 → 당분간 로또만.
LOTTERY_GAMES=LOTTO645
# dhlottery 계정: 이 저장소가 아니라 서버 사이드카 .env(sidecar/lottery/.env)에 직접 설정.
#   DH_USER / DH_PASSWORD  — 채팅/저장소에 절대 남기지 말 것.
